# ==========================================
# AI Travel Itinerary Planner - Backend Config
# ==========================================

# Server Environment
ENVIRONMENT=development
PORT=8000

# Google Gemini API Key
# Obtain free from: https://aistudio.google.com/app/apikey
# If left empty, the application runs smoothly in high-fidelity Demo Mode!
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Supabase Credentials (PostgreSQL & Authentication)
# Obtain from: https://supabase.com/dashboard/project/<your-project-id>/settings/api
# If left empty, the application uses local JSON/in-memory store!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# Unsplash API Key (Optional)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,*
