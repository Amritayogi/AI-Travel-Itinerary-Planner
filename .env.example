# ==========================================
# WanderAI Frontend - Environment Variables
# ==========================================

# Backend REST API URL
# For local development: http://localhost:8000/api
# For production (Render): https://your-backend-app.onrender.com/api
VITE_API_URL=http://localhost:8000/api

# Supabase Authentication & Database (Optional)
# If left empty, the application uses simulated local auth and demo user mode!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
